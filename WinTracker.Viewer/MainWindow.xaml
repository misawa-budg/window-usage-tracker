<Window
    x:Class="WinTracker.Viewer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinTracker.Viewer"
    Title="WinTracker">
    <Grid
        RequestedTheme="Dark"
        Background="{ThemeResource BrushPageBackground}"
        UseLayoutRounding="True"
        Padding="24,20">
        <Grid.Resources>
            <Style
                x:Key="TimelineSection"
                TargetType="Border">
                <Setter
                    Property="Background"
                    Value="{ThemeResource BrushSectionBackground}" />
                <Setter
                    Property="BorderBrush"
                    Value="{ThemeResource BrushBorderSoft}" />
                <Setter
                    Property="BorderThickness"
                    Value="1" />
                <Setter
                    Property="CornerRadius"
                    Value="6" />
                <Setter
                    Property="Padding"
                    Value="16,14" />
            </Style>
            <DataTemplate
                x:Key="TimeGuidesTemplate">
                <Grid
                    IsHitTestVisible="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition
                            Width="*" />
                        <ColumnDefinition
                            Width="*" />
                        <ColumnDefinition
                            Width="*" />
                        <ColumnDefinition
                            Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Grid.Column="1"
                        BorderThickness="1,0,0,0"
                        BorderBrush="{ThemeResource BrushTimeGuide}" />
                    <Border
                        Grid.Column="2"
                        BorderThickness="1,0,0,0"
                        BorderBrush="{ThemeResource BrushTimeGuide}" />
                    <Border
                        Grid.Column="3"
                        BorderThickness="1,0,0,0"
                        BorderBrush="{ThemeResource BrushTimeGuide}" />
                </Grid>
            </DataTemplate>
            <Style
                x:Key="SectionHeading"
                TargetType="TextBlock">
                <Setter
                    Property="FontSize"
                    Value="16" />
                <Setter
                    Property="FontWeight"
                    Value="SemiBold" />
                <Setter
                    Property="Foreground"
                    Value="{ThemeResource BrushTextPrimary}" />
            </Style>
            <Style
                x:Key="Caption"
                TargetType="TextBlock">
                <Setter
                    Property="FontSize"
                    Value="12" />
                <Setter
                    Property="Foreground"
                    Value="{ThemeResource BrushTextSecondary}" />
                <Setter
                    Property="TextWrapping"
                    Value="Wrap" />
            </Style>
            <Style
                x:Key="TimelineRow"
                TargetType="Border">
                <Setter
                    Property="Padding"
                    Value="0,8" />
                <Setter
                    Property="BorderBrush"
                    Value="{ThemeResource BrushBorderSoft}" />
                <Setter
                    Property="BorderThickness"
                    Value="0,0,0,1" />
            </Style>
            <DataTemplate
                x:Key="LegendTemplate"
                x:DataType="local:LegendItemViewModel">
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8"
                    Margin="0,0,16,0"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="{x:Bind Label}">
                    <Border
                        Width="10"
                        Height="10"
                        CornerRadius="2"
                        Background="{x:Bind Fill}" />
                    <TextBlock
                        Text="{x:Bind Label}"
                        FontSize="12"
                        MaxWidth="132"
                        Foreground="{ThemeResource BrushTextSecondary}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DataTemplate>
            <!-- Interior tick labels span two quarter-day columns, centered on their shared boundary. -->
            <DataTemplate
                x:Key="TimeAxisTemplate">
                <Grid
                    Height="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition
                            Width="*" />
                        <ColumnDefinition
                            Width="*" />
                        <ColumnDefinition
                            Width="*" />
                        <ColumnDefinition
                            Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        Text="00:00"
                        Style="{StaticResource Caption}" />
                    <TextBlock
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        HorizontalAlignment="Center"
                        Text="06:00"
                        Style="{StaticResource Caption}" />
                    <TextBlock
                        Grid.Column="1"
                        Grid.ColumnSpan="2"
                        HorizontalAlignment="Center"
                        Text="12:00"
                        Style="{StaticResource Caption}" />
                    <TextBlock
                        Grid.Column="2"
                        Grid.ColumnSpan="2"
                        HorizontalAlignment="Center"
                        Text="18:00"
                        Style="{StaticResource Caption}" />
                    <TextBlock
                        Grid.Column="3"
                        Text="24:00"
                        HorizontalAlignment="Right"
                        Style="{StaticResource Caption}" />
                </Grid>
            </DataTemplate>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="*" />
        </Grid.RowDefinitions>
        <Grid
            ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    Width="*" />
                <ColumnDefinition
                    Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="DateRangeTextBlock"
                FontSize="24"
                FontWeight="SemiBold"
                Foreground="{ThemeResource BrushTextPrimary}"
                VerticalAlignment="Center"
                TextTrimming="CharacterEllipsis" />
            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="12">
                <ComboBox
                    x:Name="RangeComboBox"
                    Width="140"
                    SelectedIndex="0"
                    AutomationProperties.Name="表示期間"
                    SelectionChanged="OnRangeSelectionChanged">
                    <ComboBoxItem
                        Content="今日"
                        Tag="24h" />
                    <ComboBoxItem
                        Content="直近7日"
                        Tag="1week" />
                </ComboBox>
                <Button
                    x:Name="RefreshButton"
                    Content="更新"
                    Click="OnRefreshClicked" />
            </StackPanel>
        </Grid>
        <Grid
            Grid.Row="1"
            Margin="0,8,0,20"
            ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    Width="Auto" />
                <ColumnDefinition
                    Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="CollectorStatusTextBlock"
                Style="{StaticResource Caption}"
                ToolTipService.ToolTip="Collectorプロセスの検出状態です。記録の更新や保存の成功を保証する表示ではありません。" />
            <TextBlock
                x:Name="StatusTextBlock"
                Grid.Column="1"
                Style="{StaticResource Caption}"
                HorizontalAlignment="Right"
                AutomationProperties.LiveSetting="Polite" />
        </Grid>
        <ScrollViewer
            Grid.Row="2"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollMode="Disabled"
            HorizontalContentAlignment="Stretch"
            Padding="0,0,12,0">
            <StackPanel
                Spacing="20">
                <Border
                    Style="{StaticResource TimelineSection}">
                    <StackPanel
                        Spacing="8">
                        <TextBlock
                            Text="最前面の推移"
                            Style="{StaticResource SectionHeading}" />
                        <ItemsControl
                            x:Name="OverviewLegendItemsControl"
                            ItemTemplate="{StaticResource LegendTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapGrid
                                        Orientation="Horizontal"
                                        ItemWidth="160"
                                        ItemHeight="28" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <StackPanel
                            x:Name="OverviewDailyPanel">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition
                                        Width="140" />
                                    <ColumnDefinition
                                        Width="*" />
                                    <ColumnDefinition
                                        Width="104" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    x:Name="OverviewHeaderLabelTextBlock"
                                    Style="{StaticResource Caption}" />
                                <ContentControl
                                    Grid.Column="1"
                                    ContentTemplate="{StaticResource TimeAxisTemplate}"
                                    HorizontalContentAlignment="Stretch"
                                    IsTabStop="False" />
                                <TextBlock
                                    Grid.Column="2"
                                    Text="合計（時:分）"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource Caption}" />
                            </Grid>
                            <ItemsControl
                                x:Name="OverviewDailyListView">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate
                                        x:DataType="local:StateStackRowViewModel">
                                        <Border
                                            Style="{StaticResource TimelineRow}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition
                                                        Width="140" />
                                                    <ColumnDefinition
                                                        Width="*" />
                                                    <ColumnDefinition
                                                        Width="104" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Text="{x:Bind Label}"
                                                    Margin="0,0,12,0"
                                                    FontSize="14"
                                                    VerticalAlignment="Center"
                                                    Foreground="{ThemeResource BrushTextPrimary}"
                                                    TextTrimming="CharacterEllipsis"
                                                    ToolTipService.ToolTip="{x:Bind Label}" />
                                                <Grid
                                                    Grid.Column="1"
                                                    Height="28"
                                                    Background="{ThemeResource BrushRail}">
                                                    <ContentControl
                                                        ContentTemplate="{StaticResource TimeGuidesTemplate}"
                                                        HorizontalContentAlignment="Stretch"
                                                        VerticalContentAlignment="Stretch"
                                                        IsHitTestVisible="False"
                                                        IsTabStop="False" />
                                                    <Border>
                                                        <Viewbox
                                                            Stretch="Fill"
                                                            StretchDirection="Both">
                                                            <local:TimelineTrack
                                                                Width="960"
                                                                Height="50"
                                                                Columns="{x:Bind Columns}" />
                                                        </Viewbox>
                                                    </Border>
                                                </Grid>
                                                <TextBlock
                                                    Grid.Column="2"
                                                    Text="{x:Bind TotalLabel}"
                                                    FontSize="14"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Foreground="{ThemeResource BrushTextPrimary}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border
                    Style="{StaticResource TimelineSection}">
                    <StackPanel
                        Spacing="8">
                        <TextBlock
                            Text="アプリ・サービスの記録"
                            Style="{StaticResource SectionHeading}" />
                        <StackPanel
                            x:Name="AppSelectorCard"
                            Orientation="Horizontal"
                            Spacing="12"
                            Margin="0,4">
                            <TextBlock
                                Text="表示"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource BrushTextPrimary}" />
                            <ComboBox
                                x:Name="AppDisplayModeComboBox"
                                Width="220"
                                SelectedIndex="0"
                                AutomationProperties.Name="アプリ・サービスの表示方法"
                                SelectionChanged="OnAppDisplayModeSelectionChanged">
                                <ComboBoxItem
                                    Content="サービス別（最前面）"
                                    Tag="Services" />
                                <ComboBoxItem
                                    Content="状態をまとめる"
                                    Tag="Running" />
                                <ComboBoxItem
                                    Content="状態別に見る"
                                    Tag="StateDetails" />
                            </ComboBox>
                            <TextBlock
                                x:Name="AppLabelTextBlock"
                                Text="アプリ"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource BrushTextPrimary}" />
                            <ComboBox
                                x:Name="AppComboBox"
                                Width="240"
                                DisplayMemberPath="DisplayName"
                                AutomationProperties.Name="週表示のアプリ・サービス"
                                SelectionChanged="OnAppSelectionChanged" />
                        </StackPanel>
                        <ItemsControl
                            x:Name="AppLegendItemsControl">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel
                                        Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate
                                    x:DataType="local:LegendItemViewModel">
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        Margin="0,0,24,4">
                                        <Border
                                            Width="10"
                                            Height="10"
                                            CornerRadius="2"
                                            Background="{x:Bind Fill}" />
                                        <TextBlock
                                            Text="{x:Bind Label}"
                                            Style="{StaticResource Caption}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel
                            x:Name="AppDailyPanel">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition
                                        Width="140" />
                                    <ColumnDefinition
                                        Width="*" />
                                    <ColumnDefinition
                                        Width="104" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    x:Name="AppHeaderLabelTextBlock"
                                    Style="{StaticResource Caption}" />
                                <ContentControl
                                    Grid.Column="1"
                                    ContentTemplate="{StaticResource TimeAxisTemplate}"
                                    HorizontalContentAlignment="Stretch"
                                    IsTabStop="False" />
                                <TextBlock
                                    Grid.Column="2"
                                    Text="合計（時:分）"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource Caption}" />
                            </Grid>
                            <ItemsControl
                                x:Name="AppDailyListView">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate
                                        x:DataType="local:StateLaneViewModel">
                                        <Border
                                            Style="{StaticResource TimelineRow}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition
                                                        Width="140" />
                                                    <ColumnDefinition
                                                        Width="*" />
                                                    <ColumnDefinition
                                                        Width="104" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Text="{x:Bind Label}"
                                                    Margin="0,0,12,0"
                                                    FontSize="14"
                                                    VerticalAlignment="Center"
                                                    Foreground="{ThemeResource BrushTextPrimary}"
                                                    TextTrimming="CharacterEllipsis"
                                                    ToolTipService.ToolTip="{x:Bind Label}" />
                                                <Grid
                                                    Grid.Column="1"
                                                    Height="28"
                                                    Background="{ThemeResource BrushRail}">
                                                    <ContentControl
                                                        ContentTemplate="{StaticResource TimeGuidesTemplate}"
                                                        HorizontalContentAlignment="Stretch"
                                                        VerticalContentAlignment="Stretch"
                                                        IsHitTestVisible="False"
                                                        IsTabStop="False" />
                                                    <Border>
                                                        <Viewbox
                                                            Stretch="Fill"
                                                            StretchDirection="Both">
                                                            <Grid
                                                                Width="960"
                                                                Height="50">
                                                                <ItemsControl
                                                                    ItemsSource="{x:Bind Segments}"
                                                                    UseLayoutRounding="False">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <StackPanel
                                                                                Orientation="Horizontal" />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate
                                                                            x:DataType="local:AbsoluteSegmentViewModel">
                                                                            <Border
                                                                                Width="{x:Bind Width}"
                                                                                Height="46"
                                                                                Margin="0,2,0,0"
                                                                                Background="{x:Bind Fill}"
                                                                                ToolTipService.ToolTip="{x:Bind Tooltip}" />
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </Grid>
                                                        </Viewbox>
                                                    </Border>
                                                </Grid>
                                                <TextBlock
                                                    Grid.Column="2"
                                                    Text="{x:Bind TotalLabel}"
                                                    FontSize="14"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Foreground="{ThemeResource BrushTextPrimary}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
